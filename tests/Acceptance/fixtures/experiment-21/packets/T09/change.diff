diff --git a/tests/Feature/Services/ImageServiceTest.php b/tests/Feature/Services/ImageServiceTest.php
new file mode 100644
index 0000000..a9964b2
--- /dev/null
+++ b/tests/Feature/Services/ImageServiceTest.php
@@ -0,0 +1,64 @@
+<?php
+
+namespace Tests\Feature\Services;
+
+use App\Services\ImageService;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+use InvalidArgumentException;
+use Tests\TestCase;
+
+class ImageServiceTest extends TestCase
+{
+    public function test_stores_and_processes_an_image(): void
+    {
+        Storage::fake('public');
+
+        $file = UploadedFile::fake()->image('dish.jpg', 2000, 1000);
+
+        $result = (new ImageService)->store($file, 'dishes');
+
+        $this->assertSame('image/webp', $result['mime_type']);
+        $this->assertLessThanOrEqual(1920, $result['width']);
+        $this->assertStringStartsWith('dishes/', $result['path']);
+        $this->assertNotEmpty($result['url']);
+        $this->assertGreaterThan(0, $result['size_bytes']);
+        Storage::disk('public')->assertExists($result['path']);
+    }
+
+    public function test_delete_removes_file_from_storage(): void
+    {
+        Storage::fake('public');
+
+        $file = UploadedFile::fake()->image('branch.jpg', 800, 600);
+        $result = (new ImageService)->store($file, 'branches');
+
+        Storage::disk('public')->assertExists($result['path']);
+
+        (new ImageService)->delete($result['path']);
+
+        Storage::disk('public')->assertMissing($result['path']);
+    }
+
+    public function test_rejects_oversized_image(): void
+    {
+        Storage::fake('public');
+
+        $this->expectException(InvalidArgumentException::class);
+
+        $file = UploadedFile::fake()->create('big.jpg', 6000, 'image/jpeg');
+
+        (new ImageService)->store($file, 'dishes');
+    }
+
+    public function test_rejects_unsupported_mime_type(): void
+    {
+        Storage::fake('public');
+
+        $this->expectException(InvalidArgumentException::class);
+
+        $file = UploadedFile::fake()->create('doc.pdf', 100, 'application/pdf');
+
+        (new ImageService)->store($file, 'dishes');
+    }
+}
