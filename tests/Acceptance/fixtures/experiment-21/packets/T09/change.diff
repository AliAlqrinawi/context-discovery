+<?php
+
+namespace App\Actions\Branch;
+
+use App\DTOs\Branch\CreateBranchDTO;
+use App\Models\Branch;
+use App\Repositories\BranchRepository;
+use App\Services\ImageService;
+use Illuminate\Support\Facades\Cache;
+
+class CreateBranchAction
+{
+    public function __construct(
+        private readonly BranchRepository $repository,
+        private readonly ImageService $imageService,
+    ) {}
+
+    public function execute(CreateBranchDTO $dto): Branch
+    {
+        $data = [
+            'name_ar' => $dto->name_ar,
+            'name_en' => $dto->name_en,
+            'city' => $dto->city,
+            'location_ar' => $dto->location_ar,
+            'location_en' => $dto->location_en,
+            'phone' => $dto->phone,
+            'opening_time' => $dto->opening_time,
+            'closing_time' => $dto->closing_time,
+            'google_maps_url' => $dto->google_maps_url,
+            'order' => $dto->order,
+        ];
+
+        if ($dto->image) {
+            $stored = $this->imageService->store($dto->image, 'branches');
+            $data['image_path'] = $stored['path'];
+            $data['image_url'] = $stored['url'];
+        }
+
+        $branch = $this->repository->create($data);
+
+        Cache::tags(['branches'])->flush();
+
+        return $branch;
+    }
+}
