@@ -0,0 +1,45 @@
+<?php
+
+namespace App\Actions\MediaItem;
+
+use App\DTOs\MediaItem\UploadMediaDTO;
+use App\Models\MediaItem;
+use App\Repositories\MediaItemRepository;
+use App\Services\ImageService;
+use Illuminate\Support\Facades\Cache;
+
+class UploadMediaAction
+{
+    public function __construct(
+        private readonly MediaItemRepository $repository,
+        private readonly ImageService $imageService,
+    ) {}
+
+    public function execute(UploadMediaDTO $dto): MediaItem
+    {
+        $existing = $this->repository->findBySlot($dto->page, $dto->section, $dto->key);
+
+        if ($existing && $existing->path) {
+            $this->imageService->delete($existing->path);
+        }
+
+        $stored = $this->imageService->store($dto->image, "media/{$dto->page}");
+
+        $data = [
+            'page' => $dto->page,
+            'section' => $dto->section,
+            'key' => $dto->key,
+            'alt_ar' => $dto->alt_ar,
+            'alt_en' => $dto->alt_en,
+            ...$stored,
+        ];
+
+        $mediaItem = $existing
+            ? $this->repository->update($existing->id, $data)
+            : $this->repository->create($data);
+
+        Cache::tags(['media_items'])->flush();
+
+        return $mediaItem;
+    }
+}
