+<?php
+
+namespace Tests\Feature\Actions;
+
+use App\Actions\Auth\LoginAction;
+use App\DTOs\Auth\LoginDTO;
+use Database\Seeders\UserSeeder;
+use Illuminate\Auth\AuthenticationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class LoginActionTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->seed(UserSeeder::class);
+    }
+
+    public function test_correct_credentials_return_token_and_user(): void
+    {
+        $action = new LoginAction;
+
+        $result = $action->execute(new LoginDTO(
+            email: 'admin@abouelsid.com',
+            password: 'password',
+        ));
+
+        $this->assertArrayHasKey('token', $result);
+        $this->assertArrayHasKey('user', $result);
+        $this->assertNotEmpty($result['token']);
+        $this->assertSame('admin@abouelsid.com', $result['user']->email);
+    }
+
+    public function test_wrong_credentials_throw_authentication_exception(): void
+    {
+        $this->expectException(AuthenticationException::class);
+
+        $action = new LoginAction;
+
+        $action->execute(new LoginDTO(
+            email: 'admin@abouelsid.com',
+            password: 'wrong-password',
+        ));
+    }
+}
