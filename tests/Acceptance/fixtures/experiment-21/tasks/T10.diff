@@ -0,0 +1,122 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Category;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class PublicApiTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->seed();
+    }
+
+    private function apiKey(): string
+    {
+        return env('WEBSITE_API_KEY');
+    }
+
+    public function test_get_dishes_with_correct_api_key_returns_200(): void
+    {
+        $response = $this->getJson('/api/v1/dishes', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJson(['success' => true])
+            ->assertJsonPath('data.meta.total', 5);
+    }
+
+    public function test_get_dishes_without_key_returns_401(): void
+    {
+        $response = $this->getJson('/api/v1/dishes');
+
+        $response->assertStatus(401)
+            ->assertJson(['success' => false]);
+    }
+
+    public function test_get_dishes_filtered_by_category_returns_only_that_categorys_dishes(): void
+    {
+        $mainsId = Category::where('slug', 'mains')->first()->id;
+
+        $response = $this->getJson("/api/v1/dishes?category_id={$mainsId}", ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJsonPath('data.meta.total', 2);
+
+        foreach ($response->json('data.items') as $dish) {
+            $this->assertSame($mainsId, $dish['category']['id']);
+        }
+    }
+
+    public function test_get_branches_returns_two_branches_with_both_languages(): void
+    {
+        $response = $this->getJson('/api/v1/branches', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJsonCount(2, 'data');
+
+        $branch = $response->json('data.0');
+        $this->assertArrayHasKey('name_ar', $branch);
+        $this->assertArrayHasKey('name_en', $branch);
+    }
+
+    public function test_get_page_contents_for_home_hero_returns_hero_content(): void
+    {
+        $response = $this->getJson('/api/v1/page-contents?page=home&section=hero', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200);
+
+        $data = $response->json('data');
+        $this->assertArrayHasKey('hero', $data);
+        $this->assertArrayHasKey('title', $data['hero']);
+        $this->assertSame('أبو السيد', $data['hero']['title']['value_ar']);
+    }
+
+    public function test_get_testimonials_returns_ten(): void
+    {
+        $response = $this->getJson('/api/v1/testimonials', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJsonCount(10, 'data');
+    }
+
+    public function test_submit_quote_request_with_valid_data_returns_201(): void
+    {
+        $response = $this->postJson('/api/v1/catering/quote-requests', [
+            'name' => 'نورة العتيبي',
+            'phone' => '0551234567',
+            'email' => 'noura@example.com',
+            'event_date' => now()->addMonth()->toDateString(),
+            'guests_count' => 150,
+            'branch' => 'jeddah_delivery',
+            'event_type' => 'wedding',
+            'budget_range' => '25k_50k',
+            'notes' => 'نريد قائمة مخصصة',
+        ], ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(201)
+            ->assertJson(['success' => true]);
+
+        $this->assertDatabaseHas('quote_requests', ['phone' => '0551234567']);
+    }
+
+    public function test_submit_quote_request_with_missing_name_returns_422(): void
+    {
+        $response = $this->postJson('/api/v1/catering/quote-requests', [
+            'phone' => '0551234567',
+            'event_date' => now()->addMonth()->toDateString(),
+            'guests_count' => 150,
+            'branch' => 'jeddah_delivery',
+            'event_type' => 'wedding',
+        ], ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(422)
+            ->assertJson(['success' => false, 'message' => 'Validation failed'])
+            ->assertJsonValidationErrors(['name']);
+    }
+}
