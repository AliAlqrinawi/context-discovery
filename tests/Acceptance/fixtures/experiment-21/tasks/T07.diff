diff --git a/tests/Unit/EnumsTest.php b/tests/Unit/EnumsTest.php
new file mode 100644
index 0000000..f304f0d
--- /dev/null
+++ b/tests/Unit/EnumsTest.php
@@ -0,0 +1,99 @@
+<?php
+
+namespace Tests\Unit;
+
+use App\Enums\BranchLocationEnum;
+use App\Enums\BudgetRangeEnum;
+use App\Enums\EventTypeEnum;
+use App\Enums\MediaTypeEnum;
+use App\Enums\PageEnum;
+use App\Enums\QuoteRequestStatusEnum;
+use App\Enums\UserRoleEnum;
+use PHPUnit\Framework\TestCase;
+
+class EnumsTest extends TestCase
+{
+    public function test_quote_request_status_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['pending', 'reviewed', 'contacted', 'closed'],
+            QuoteRequestStatusEnum::values()
+        );
+
+        foreach (QuoteRequestStatusEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+
+    public function test_event_type_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['wedding', 'corporate', 'family', 'birthday', 'engagement', 'religious', 'other'],
+            EventTypeEnum::values()
+        );
+
+        foreach (EventTypeEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+
+    public function test_budget_range_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['under_5k', '5k_10k', '10k_25k', '25k_50k', 'over_50k'],
+            BudgetRangeEnum::values()
+        );
+
+        foreach (BudgetRangeEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+
+    public function test_branch_location_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['jeddah_delivery', 'riyadh_delivery', 'hall_jeddah', 'hall_riyadh', 'other'],
+            BranchLocationEnum::values()
+        );
+
+        foreach (BranchLocationEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+
+    public function test_user_role_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['super_admin', 'admin', 'manager'],
+            UserRoleEnum::values()
+        );
+
+        foreach (UserRoleEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+
+    public function test_media_type_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['image', 'video'],
+            MediaTypeEnum::values()
+        );
+
+        foreach (MediaTypeEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+
+    public function test_page_enum_has_correct_cases(): void
+    {
+        $this->assertSame(
+            ['home', 'story', 'menu', 'order', 'catering', 'branches', 'global'],
+            PageEnum::values()
+        );
+
+        foreach (PageEnum::cases() as $case) {
+            $this->assertNotEmpty($case->label());
+        }
+    }
+}
