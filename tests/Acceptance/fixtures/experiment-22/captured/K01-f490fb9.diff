+    public function test_get_dishes_filtered_by_signature_returns_only_signature_dishes_ordered(): void
+    {
+        $expectedCount = \App\Models\Dish::where('is_signature', true)->count();
+
+        $response = $this->getJson('/api/v1/dishes?signature=true', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJsonPath('data.meta.total', $expectedCount);
+
+        $orders = [];
+        foreach ($response->json('data.items') as $dish) {
+            $this->assertTrue($dish['is_signature']);
+            $orders[] = $dish['order'];
+        }
+
+        $this->assertSame($orders, collect($orders)->sort()->values()->all());
+    }
