+<?php
+
+namespace App\Repositories;
+
+use App\Models\TrackingSetting;
+
+class TrackingSettingRepository
+{
+    public function get(): TrackingSetting
+    {
+        return TrackingSetting::first() ?? TrackingSetting::create();
+    }
+
+    public function update(array $data): TrackingSetting
+    {
+        $trackingSetting = $this->get();
+        $trackingSetting->update($data);
+
+        return $trackingSetting;
+    }
+}
