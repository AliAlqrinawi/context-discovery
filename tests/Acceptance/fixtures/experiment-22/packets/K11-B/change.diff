+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Actions\Seo\BulkUpdateSeoSettingsAction;
+use App\Actions\Seo\UpdateSeoSettingAction;
+use App\DTOs\Seo\BulkUpdateSeoSettingsDTO;
+use App\DTOs\Seo\UpdateSeoSettingDTO;
+use App\Http\Controllers\Controller;
+use App\Http\Requests\Seo\BulkUpdateSeoSettingsRequest;
+use App\Http\Requests\Seo\UpdateSeoSettingRequest;
+use App\Http\Resources\Seo\SeoSettingResource;
+use App\Repositories\SeoSettingRepository;
+use Illuminate\Http\JsonResponse;
+
+class SeoSettingController extends Controller
+{
+    public function index(SeoSettingRepository $repository): JsonResponse
+    {
+        return $this->success(SeoSettingResource::collection($repository->getAll()), __('messages.fetched'));
+    }
+
+    public function update(UpdateSeoSettingRequest $request, int $id, UpdateSeoSettingAction $action): JsonResponse
+    {
+        $seoSetting = $action->execute($id, UpdateSeoSettingDTO::fromRequest($request));
+
+        return $this->success(new SeoSettingResource($seoSetting), __('messages.updated'));
+    }
+
+    public function bulkUpdate(BulkUpdateSeoSettingsRequest $request, BulkUpdateSeoSettingsAction $action): JsonResponse
+    {
+        $action->execute(BulkUpdateSeoSettingsDTO::fromRequest($request));
+
+        return $this->success(null, __('messages.updated'));
+    }
+}
