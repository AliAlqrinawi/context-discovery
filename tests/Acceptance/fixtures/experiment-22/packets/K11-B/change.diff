+<?php
+
+namespace App\Http\Controllers\Public;
+
+use App\Actions\Seo\GetEffectiveSeoAction;
+use App\Http\Controllers\Controller;
+use App\Http\Resources\Concerns\ResolvesLocale;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class SeoController extends Controller
+{
+    use ResolvesLocale;
+
+    public function show(Request $request, GetEffectiveSeoAction $action): JsonResponse
+    {
+        $page = $request->filled('page') ? $request->string('page')->toString() : null;
+        $seo = $action->execute($page);
+
+        $data = [
+            'page' => $seo['page'],
+            'meta_title' => $this->resolveLocale($seo['meta_title_ar'], $seo['meta_title_en']),
+            'meta_title_ar' => $seo['meta_title_ar'],
+            'meta_title_en' => $seo['meta_title_en'],
+            'meta_description' => $this->resolveLocale($seo['meta_description_ar'], $seo['meta_description_en']),
+            'meta_description_ar' => $seo['meta_description_ar'],
+            'meta_description_en' => $seo['meta_description_en'],
+            'meta_keywords' => $this->resolveLocale($seo['meta_keywords_ar'], $seo['meta_keywords_en']),
+            'meta_keywords_ar' => $seo['meta_keywords_ar'],
+            'meta_keywords_en' => $seo['meta_keywords_en'],
+            'og_title' => $this->resolveLocale($seo['og_title_ar'], $seo['og_title_en']),
+            'og_title_ar' => $seo['og_title_ar'],
+            'og_title_en' => $seo['og_title_en'],
+            'og_description' => $this->resolveLocale($seo['og_description_ar'], $seo['og_description_en']),
+            'og_description_ar' => $seo['og_description_ar'],
+            'og_description_en' => $seo['og_description_en'],
+            'og_image' => $seo['og_image'],
+            'canonical_url' => $seo['canonical_url'],
+            'robots_noindex' => $seo['robots_noindex'],
+            'tracking' => $seo['tracking'],
+            'locale' => app()->getLocale(),
+        ];
+
+        return $this->success($data, __('messages.fetched'));
+    }
+}
