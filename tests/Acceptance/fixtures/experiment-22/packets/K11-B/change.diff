+<?php
+
+namespace App\Repositories;
+
+use App\Models\SeoSetting;
+use Illuminate\Database\Eloquent\Collection;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\DB;
+
+class SeoSettingRepository
+{
+    private const FILLABLE = [
+        'meta_title_ar', 'meta_title_en',
+        'meta_description_ar', 'meta_description_en',
+        'meta_keywords_ar', 'meta_keywords_en',
+        'og_title_ar', 'og_title_en',
+        'og_description_ar', 'og_description_en',
+        'og_image', 'canonical_url', 'robots_noindex',
+    ];
+
+    public function getAll(): Collection
+    {
+        return SeoSetting::orderByRaw('page IS NULL DESC')->orderBy('page')->get();
+    }
+
+    public function getGlobal(): ?SeoSetting
+    {
+        return SeoSetting::whereNull('page')->first();
+    }
+
+    public function getByPage(string $page): ?SeoSetting
+    {
+        return SeoSetting::where('page', $page)->first();
+    }
+
+    public function getById(int $id): SeoSetting
+    {
+        return SeoSetting::findOrFail($id);
+    }
+
+    public function update(int $id, array $data): SeoSetting
+    {
+        $seoSetting = SeoSetting::findOrFail($id);
+        $seoSetting->update(Arr::only($data, self::FILLABLE));
+
+        return $seoSetting;
+    }
+
+    public function bulkUpdate(array $items): void
+    {
+        DB::transaction(function () use ($items) {
+            foreach ($items as $item) {
+                SeoSetting::findOrFail($item['id'])
+                    ->update(Arr::only($item, self::FILLABLE));
+            }
+        });
+    }
+}
