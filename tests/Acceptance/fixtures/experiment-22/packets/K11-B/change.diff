@@ -0,0 +1,70 @@
+<?php
+
+namespace App\Actions\Seo;
+
+use App\Models\SeoSetting;
+use App\Repositories\SeoSettingRepository;
+use App\Repositories\TrackingSettingRepository;
+use Illuminate\Support\Facades\Cache;
+
+class GetEffectiveSeoAction
+{
+    private const BILINGUAL_FIELDS = [
+        'meta_title_ar', 'meta_title_en',
+        'meta_description_ar', 'meta_description_en',
+        'meta_keywords_ar', 'meta_keywords_en',
+        'og_title_ar', 'og_title_en',
+        'og_description_ar', 'og_description_en',
+    ];
+
+    public function __construct(
+        private readonly SeoSettingRepository $seoRepository,
+        private readonly TrackingSettingRepository $trackingRepository,
+    ) {}
+
+    public function execute(?string $page = null): array
+    {
+        $locale = app()->getLocale();
+        $key = 'seo_effective_'.($page ?? 'global')."_{$locale}";
+
+        return Cache::tags(['seo_settings'])->remember(
+            $key,
+            now()->addHour(),
+            fn () => $this->merge($page)
+        );
+    }
+
+    private function merge(?string $page): array
+    {
+        $global = $this->seoRepository->getGlobal();
+        $override = $page ? $this->seoRepository->getByPage($page) : null;
+
+        $result = ['page' => $page];
+
+        foreach (self::BILINGUAL_FIELDS as $field) {
+            $result[$field] = $this->firstNonEmpty($override, $global, $field);
+        }
+
+        $result['og_image'] = $this->firstNonEmpty($override, $global, 'og_image');
+        $result['canonical_url'] = $this->firstNonEmpty($override, $global, 'canonical_url');
+        $result['robots_noindex'] = $override?->robots_noindex ?? $global?->robots_noindex ?? false;
+
+        $tracking = $this->trackingRepository->get();
+        $result['tracking'] = [
+            'gtm_container_id' => $tracking->gtm_container_id,
+            'ga4_measurement_id' => $tracking->ga4_measurement_id,
+            'meta_pixel_id' => $tracking->meta_pixel_id,
+            'snap_pixel_id' => $tracking->snap_pixel_id,
+            'tiktok_pixel_id' => $tracking->tiktok_pixel_id,
+        ];
+
+        return $result;
+    }
+
+    private function firstNonEmpty(?SeoSetting $override, ?SeoSetting $global, string $field): ?string
+    {
+        return ($override?->{$field} !== null && $override->{$field} !== '')
+            ? $override->{$field}
+            : $global?->{$field};
+    }
+}
