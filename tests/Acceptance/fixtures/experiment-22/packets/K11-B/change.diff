+<?php
+
+namespace App\Http\Requests\Seo;
+
+use App\Http\Requests\BaseFormRequest;
+
+class BulkUpdateSeoSettingsRequest extends BaseFormRequest
+{
+    public function authorize(): bool
+    {
+        return true;
+    }
+
+    public function rules(): array
+    {
+        return [
+            'items' => ['required', 'array', 'min:1'],
+            'items.*.id' => ['required', 'integer', 'exists:seo_settings,id'],
+            'items.*.meta_title_ar' => ['sometimes', 'nullable', 'string', 'max:255'],
+            'items.*.meta_title_en' => ['sometimes', 'nullable', 'string', 'max:255'],
+            'items.*.meta_description_ar' => ['sometimes', 'nullable', 'string'],
+            'items.*.meta_description_en' => ['sometimes', 'nullable', 'string'],
+            'items.*.meta_keywords_ar' => ['sometimes', 'nullable', 'string'],
+            'items.*.meta_keywords_en' => ['sometimes', 'nullable', 'string'],
+            'items.*.og_title_ar' => ['sometimes', 'nullable', 'string', 'max:255'],
+            'items.*.og_title_en' => ['sometimes', 'nullable', 'string', 'max:255'],
+            'items.*.og_description_ar' => ['sometimes', 'nullable', 'string'],
+            'items.*.og_description_en' => ['sometimes', 'nullable', 'string'],
+            'items.*.og_image' => ['sometimes', 'nullable', 'string', 'max:500'],
+            'items.*.canonical_url' => ['sometimes', 'nullable', 'string', 'max:500'],
+            'items.*.robots_noindex' => ['sometimes', 'nullable', 'boolean'],
+        ];
+    }
+}
