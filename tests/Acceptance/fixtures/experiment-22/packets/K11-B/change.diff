diff --git a/tests/Feature/SeoSettingsTest.php b/tests/Feature/SeoSettingsTest.php
new file mode 100644
index 0000000..5027f67
--- /dev/null
+++ b/tests/Feature/SeoSettingsTest.php
@@ -0,0 +1,135 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\SeoSetting;
+use App\Models\TrackingSetting;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class SeoSettingsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->seed();
+    }
+
+    private function apiKey(): string
+    {
+        return config('services.website_api_key');
+    }
+
+    private function token(): string
+    {
+        $user = User::where('email', 'admin@abouelsid.com')->first();
+
+        return $user->createToken('test-token')->plainTextToken;
+    }
+
+    public function test_public_seo_for_page_with_no_override_inherits_global(): void
+    {
+        $global = SeoSetting::whereNull('page')->first();
+
+        $response = $this->getJson('/api/v1/seo?page=home', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJsonPath('data.page', 'home')
+            ->assertJsonPath('data.meta_title_ar', $global->meta_title_ar)
+            ->assertJsonPath('data.meta_title_en', $global->meta_title_en)
+            ->assertJsonPath('data.robots_noindex', false)
+            ->assertJsonStructure(['data' => ['tracking' => [
+                'gtm_container_id', 'ga4_measurement_id', 'meta_pixel_id', 'snap_pixel_id', 'tiktok_pixel_id',
+            ]]]);
+    }
+
+    public function test_public_seo_without_page_param_returns_global_only(): void
+    {
+        $global = SeoSetting::whereNull('page')->first();
+
+        $response = $this->getJson('/api/v1/seo', ['X-API-Key' => $this->apiKey()]);
+
+        $response->assertStatus(200)
+            ->assertJsonPath('data.page', null)
+            ->assertJsonPath('data.meta_title_ar', $global->meta_title_ar);
+    }
+
+    public function test_admin_seo_index_without_token_returns_401(): void
+    {
+        $response = $this->getJson('/api/v1/admin/seo');
+
+        $response->assertStatus(401)
+            ->assertJson(['success' => false]);
+    }
+
+    public function test_admin_seo_index_returns_nine_rows(): void
+    {
+        $response = $this->getJson('/api/v1/admin/seo', ['Authorization' => "Bearer {$this->token()}"]);
+
+        $response->assertStatus(200)
+            ->assertJsonCount(9, 'data');
+    }
+
+    public function test_admin_update_page_override_reflects_in_public_merge(): void
+    {
+        $homeRow = SeoSetting::where('page', 'home')->first();
+        $global = SeoSetting::whereNull('page')->first();
+
+        $response = $this->putJson("/api/v1/admin/seo/{$homeRow->id}", [
+            'meta_title_ar' => 'الرئيسية المخصصة',
+            'robots_noindex' => true,
+        ], ['Authorization' => "Bearer {$this->token()}"]);
+
+        $response->assertStatus(200)
+            ->assertJson(['success' => true]);
+
+        $public = $this->getJson('/api/v1/seo?page=home', ['X-API-Key' => $this->apiKey()]);
+
+        $public->assertStatus(200)
+            ->assertJsonPath('data.meta_title_ar', 'الرئيسية المخصصة')
+            ->assertJsonPath('data.robots_noindex', true)
+            // Untouched fields still fall back to the global row.
+            ->assertJsonPath('data.meta_description_ar', $global->meta_description_ar);
+    }
+
+    public function test_admin_bulk_update_seo_settings(): void
+    {
+        $menuRow = SeoSetting::where('page', 'menu')->first();
+        $catRow = SeoSetting::where('page', 'catering')->first();
+
+        $response = $this->postJson('/api/v1/admin/seo/bulk', [
+            'items' => [
+                ['id' => $menuRow->id, 'meta_title_ar' => 'القائمة'],
+                ['id' => $catRow->id, 'meta_title_ar' => 'الكاترينج'],
+            ],
+        ], ['Authorization' => "Bearer {$this->token()}"]);
+
+        $response->assertStatus(200)
+            ->assertJson(['success' => true]);
+
+        $this->assertSame('القائمة', $menuRow->fresh()->meta_title_ar);
+        $this->assertSame('الكاترينج', $catRow->fresh()->meta_title_ar);
+    }
+
+    public function test_admin_tracking_show_and_update(): void
+    {
+        $show = $this->getJson('/api/v1/admin/tracking', ['Authorization' => "Bearer {$this->token()}"]);
+        $show->assertStatus(200)->assertJsonPath('data.gtm_container_id', null);
+
+        $update = $this->putJson('/api/v1/admin/tracking', [
+            'gtm_container_id' => 'GTM-TEST123',
+        ], ['Authorization' => "Bearer {$this->token()}"]);
+
+        $update->assertStatus(200)
+            ->assertJsonPath('data.gtm_container_id', 'GTM-TEST123');
+
+        $this->assertSame(1, TrackingSetting::count());
+
+        $public = $this->getJson('/api/v1/seo?page=story', ['X-API-Key' => $this->apiKey()]);
+        $public->assertJsonPath('data.tracking.gtm_container_id', 'GTM-TEST123');
+    }
+}
