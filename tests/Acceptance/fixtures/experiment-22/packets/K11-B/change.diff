+<?php
+
+namespace App\DTOs\Seo;
+
+use Illuminate\Http\Request;
+
+class UpdateTrackingSettingsDTO
+{
+    public function __construct(
+        public readonly ?string $gtm_container_id,
+        public readonly ?string $ga4_measurement_id,
+        public readonly ?string $meta_pixel_id,
+        public readonly ?string $snap_pixel_id,
+        public readonly ?string $tiktok_pixel_id,
+    ) {}
+
+    public static function fromRequest(Request $request): self
+    {
+        // Unlike the partial-update DTOs elsewhere, this is a full-replace form
+        // (all 5 fields are always submitted together), so an empty value is
+        // taken literally as "clear this field" rather than "leave unchanged".
+        return new self(
+            gtm_container_id: $request->input('gtm_container_id'),
+            ga4_measurement_id: $request->input('ga4_measurement_id'),
+            meta_pixel_id: $request->input('meta_pixel_id'),
+            snap_pixel_id: $request->input('snap_pixel_id'),
+            tiktok_pixel_id: $request->input('tiktok_pixel_id'),
+        );
+    }
+}
