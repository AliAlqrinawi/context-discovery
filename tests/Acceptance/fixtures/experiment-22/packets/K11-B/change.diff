+<?php
+
+namespace App\Actions\Seo;
+
+use App\DTOs\Seo\UpdateSeoSettingDTO;
+use App\Models\SeoSetting;
+use App\Repositories\SeoSettingRepository;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\Cache;
+
+class UpdateSeoSettingAction
+{
+    public function __construct(
+        private readonly SeoSettingRepository $repository,
+    ) {}
+
+    public function execute(int $id, UpdateSeoSettingDTO $dto): SeoSetting
+    {
+        $data = Arr::whereNotNull([
+            'meta_title_ar' => $dto->meta_title_ar,
+            'meta_title_en' => $dto->meta_title_en,
+            'meta_description_ar' => $dto->meta_description_ar,
+            'meta_description_en' => $dto->meta_description_en,
+            'meta_keywords_ar' => $dto->meta_keywords_ar,
+            'meta_keywords_en' => $dto->meta_keywords_en,
+            'og_title_ar' => $dto->og_title_ar,
+            'og_title_en' => $dto->og_title_en,
+            'og_description_ar' => $dto->og_description_ar,
+            'og_description_en' => $dto->og_description_en,
+            'og_image' => $dto->og_image,
+            'canonical_url' => $dto->canonical_url,
+            'robots_noindex' => $dto->robots_noindex,
+        ]);
+
+        $seoSetting = $this->repository->update($id, $data);
+
+        Cache::tags(['seo_settings'])->flush();
+
+        return $seoSetting;
+    }
+}
