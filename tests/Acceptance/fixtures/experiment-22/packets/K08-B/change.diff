--- /dev/null
+++ b/tests/Feature/Actions/UpdateDishActionTest.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace Tests\Feature\Actions;
+
+use App\Actions\Dish\UpdateDishAction;
+use App\DTOs\Dish\UpdateDishDTO;
+use App\Models\Category;
+use App\Models\Dish;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Request;
+use Tests\TestCase;
+
+class UpdateDishActionTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function dish(): Dish
+    {
+        $category = Category::create([
+            'name_ar' => 'أطباق رئيسية', 'name_en' => 'Mains',
+            'slug' => 'mains', 'order' => 1,
+        ]);
+
+        return Dish::create([
+            'category_id' => $category->id,
+            'name_ar' => 'ملوخية بالأرانب', 'name_en' => 'Molokhia with Rabbit',
+            'description_ar' => 'وصف عربي', 'description_en' => 'English description',
+            'price' => 145, 'order' => 1,
+        ]);
+    }
+
+    private function update(Dish $dish, array $payload): Dish
+    {
+        return app(UpdateDishAction::class)->execute(
+            $dish->id,
+            UpdateDishDTO::fromRequest(Request::create('/x', 'POST', $payload)),
+        );
+    }
+
+    public function test_empty_description_clears_the_stored_value(): void
+    {
+        $dish = $this->update($this->dish(), [
+            'description_ar' => '',
+            'description_en' => '',
+        ]);
+
+        $this->assertNull($dish->description_ar);
+        $this->assertNull($dish->description_en);
+    }
+
+    public function test_omitted_description_leaves_the_stored_value_untouched(): void
+    {
+        $dish = $this->update($this->dish(), ['name_ar' => 'اسم جديد']);
+
+        $this->assertSame('اسم جديد', $dish->name_ar);
+        $this->assertSame('وصف عربي', $dish->description_ar);
+        $this->assertSame('English description', $dish->description_en);
+    }
+
+    public function test_each_description_clears_independently(): void
+    {
+        $dish = $this->update($this->dish(), ['description_ar' => '']);
+
+        $this->assertNull($dish->description_ar);
+        $this->assertSame('English description', $dish->description_en);
+    }
+
+    public function test_partial_update_does_not_reset_other_fields(): void
+    {
+        $original = $this->dish();
+        $original->update(['is_featured' => true, 'is_signature' => true, 'order' => 7]);
+
+        $dish = $this->update($original, ['description_ar' => '']);
+
+        $this->assertTrue($dish->is_featured);
+        $this->assertTrue($dish->is_signature);
+        $this->assertSame(7, $dish->order);
+        $this->assertSame('145.00', $dish->price);
+    }
+}
