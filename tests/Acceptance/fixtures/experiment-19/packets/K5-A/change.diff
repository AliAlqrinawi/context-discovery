diff --git a/tests/Feature/Actions/FileUploadRollbackTest.php b/tests/Feature/Actions/FileUploadRollbackTest.php
new file mode 100644
index 0000000..23f3a72
--- /dev/null
+++ b/tests/Feature/Actions/FileUploadRollbackTest.php
@@ -0,0 +1,126 @@
+<?php
+
+namespace Tests\Feature\Actions;
+
+use App\Actions\Catering\CreatePackageAction;
+use App\Actions\Dish\UpdateDishAction;
+use App\Actions\MediaItem\UploadMediaAction;
+use App\DTOs\Catering\CreatePackageDTO;
+use App\DTOs\Dish\UpdateDishDTO;
+use App\DTOs\MediaItem\UploadMediaDTO;
+use App\Models\Dish;
+use App\Repositories\CateringPackageRepository;
+use App\Repositories\DishRepository;
+use App\Repositories\MediaItemRepository;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+use RuntimeException;
+use Tests\TestCase;
+
+/**
+ * Proves the orphaned-file fix actually works: when the DB write after an
+ * upload fails, the just-stored file must be deleted and the original
+ * exception must still propagate (never swallowed).
+ */
+class FileUploadRollbackTest extends TestCase
+{
+    public function test_create_package_deletes_uploaded_image_when_db_write_fails(): void
+    {
+        Storage::fake('public');
+
+        $this->mock(CateringPackageRepository::class, function ($mock) {
+            $mock->shouldReceive('create')->andThrow(new RuntimeException('simulated DB failure'));
+        });
+
+        $action = app(CreatePackageAction::class);
+
+        $dto = new CreatePackageDTO(
+            name_ar: 'باقة',
+            name_en: 'Package',
+            description_ar: 'وصف',
+            description_en: 'Description',
+            tag_en: null,
+            price_starting_from: 100.0,
+            is_featured: false,
+            image: UploadedFile::fake()->image('package.jpg'),
+            order: 0,
+            features: [],
+        );
+
+        try {
+            $action->execute($dto);
+            $this->fail('Expected exception was not thrown.');
+        } catch (RuntimeException $e) {
+            $this->assertSame('simulated DB failure', $e->getMessage());
+        }
+
+        Storage::disk('public')->assertDirectoryEmpty('catering/packages');
+    }
+
+    public function test_upload_media_deletes_new_file_when_db_write_fails(): void
+    {
+        Storage::fake('public');
+
+        $this->mock(MediaItemRepository::class, function ($mock) {
+            $mock->shouldReceive('findBySlot')->andReturn(null);
+            $mock->shouldReceive('create')->andThrow(new RuntimeException('simulated DB failure'));
+        });
+
+        $action = app(UploadMediaAction::class);
+
+        $dto = new UploadMediaDTO(
+            page: 'home',
+            section: 'hero',
+            key: 'portrait',
+            image: UploadedFile::fake()->image('portrait.jpg'),
+            alt_ar: 'صورة',
+            alt_en: 'Image',
+        );
+
+        try {
+            $action->execute($dto);
+            $this->fail('Expected exception was not thrown.');
+        } catch (RuntimeException $e) {
+            $this->assertSame('simulated DB failure', $e->getMessage());
+        }
+
+        Storage::disk('public')->assertDirectoryEmpty('media/home');
+    }
+
+    public function test_update_dish_deletes_newly_uploaded_image_when_db_write_fails(): void
+    {
+        Storage::fake('public');
+
+        $existingDish = new Dish(['id' => 1, 'image_path' => null]);
+        $existingDish->id = 1;
+
+        $this->mock(DishRepository::class, function ($mock) use ($existingDish) {
+            $mock->shouldReceive('getById')->andReturn($existingDish);
+            $mock->shouldReceive('update')->andThrow(new RuntimeException('simulated DB failure'));
+        });
+
+        $action = app(UpdateDishAction::class);
+
+        $dto = new UpdateDishDTO(
+            name_ar: null,
+            name_en: null,
+            description_ar: null,
+            description_en: null,
+            price: null,
+            category_id: null,
+            is_featured: null,
+            is_signature: null,
+            image: UploadedFile::fake()->image('dish.jpg'),
+            order: null,
+        );
+
+        try {
+            $action->execute(1, $dto);
+            $this->fail('Expected exception was not thrown.');
+        } catch (RuntimeException $e) {
+            $this->assertSame('simulated DB failure', $e->getMessage());
+        }
+
+        Storage::disk('public')->assertDirectoryEmpty('dishes');
+    }
+}
