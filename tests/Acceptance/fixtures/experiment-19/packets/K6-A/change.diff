diff --git a/app/Services/CacheGroup.php b/app/Services/CacheGroup.php
new file mode 100644
index 0000000..5168bd9
--- /dev/null
+++ b/app/Services/CacheGroup.php
@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Services;
+
+use Closure;
+use DateTimeInterface;
+use Illuminate\Support\Facades\Cache;
+
+/**
+ * Tag-style cache invalidation for stores that do not support tagging.
+ *
+ * Production runs the file cache driver, which throws on Cache::tags(). Each
+ * group keeps an index of the keys written under it so that flush() can forget
+ * every one of them individually.
+ */
+class CacheGroup
+{
+    /**
+     * Must outlive the longest entry TTL used by callers, otherwise the index
+     * expires while its entries are still cached and they leak.
+     */
+    private const INDEX_TTL_DAYS = 7;
+
+    public static function remember(string $group, string $key, DateTimeInterface $ttl, Closure $callback): mixed
+    {
+        self::index($group, $key);
+
+        return Cache::remember($key, $ttl, $callback);
+    }
+
+    public static function flush(string $group): void
+    {
+        foreach (self::keys($group) as $key) {
+            Cache::forget($key);
+        }
+
+        Cache::forget(self::indexKey($group));
+    }
+
+    /**
+     * @return array<int, string>
+     */
+    public static function keys(string $group): array
+    {
+        $keys = Cache::get(self::indexKey($group), []);
+
+        return is_array($keys) ? $keys : [];
+    }
+
+    private static function index(string $group, string $key): void
+    {
+        $keys = self::keys($group);
+
+        if (in_array($key, $keys, true)) {
+            return;
+        }
+
+        $keys[] = $key;
+
+        Cache::put(self::indexKey($group), $keys, now()->addDays(self::INDEX_TTL_DAYS));
+    }
+
+    private static function indexKey(string $group): string
+    {
+        return "cache_group_index_{$group}";
+    }
+}
diff --git a/tests/Feature/Actions/CacheGroupTest.php b/tests/Feature/Actions/CacheGroupTest.php
new file mode 100644
index 0000000..9fcb07e
--- /dev/null
+++ b/tests/Feature/Actions/CacheGroupTest.php
@@ -0,0 +1,102 @@
+<?php
+
+namespace Tests\Feature\Actions;
+
+use App\Actions\Dish\GetDishesAction;
+use App\Actions\Dish\UpdateDishAction;
+use App\Actions\Setting\UpdateSettingsAction;
+use App\DTOs\Dish\UpdateDishDTO;
+use App\DTOs\Setting\UpdateSettingDTO;
+use App\Models\Category;
+use App\Models\Dish;
+use App\Services\CacheGroup;
+use Database\Seeders\CategorySeeder;
+use Database\Seeders\DishSeeder;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Cache;
+use Tests\TestCase;
+
+/**
+ * The rest of the suite runs on the array store, which supports tagging and so
+ * never exercised the driver production actually uses. These tests pin the
+ * cache to the file store — the one that throws on Cache::tags() — and prove
+ * that caching and group invalidation both still work there.
+ */
+class CacheGroupTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        config(['cache.default' => 'file']);
+        Cache::flush();
+
+        $this->seed(CategorySeeder::class);
+        $this->seed(DishSeeder::class);
+    }
+
+    protected function tearDown(): void
+    {
+        Cache::flush();
+
+        parent::tearDown();
+    }
+
+    public function test_reading_dishes_works_on_the_file_driver(): void
+    {
+        $result = app(GetDishesAction::class)->execute();
+
+        $this->assertSame(5, $result->total());
+        $this->assertTrue(Cache::has('dishes_ar_all_all_all_default_1'));
+    }
+
+    public function test_updating_a_dish_invalidates_every_cached_dish_query(): void
+    {
+        $mainsId = Category::where('slug', 'mains')->first()->id;
+        $action = app(GetDishesAction::class);
+
+        // Filter combinations produce keys that cannot be enumerated by hand.
+        $action->execute();
+        $action->execute(['category_id' => $mainsId]);
+        $action->execute(['featured' => true]);
+        $action->execute(['per_page' => 3]);
+
+        $cachedKeys = CacheGroup::keys('dishes');
+        $this->assertCount(4, $cachedKeys);
+
+        app(UpdateDishAction::class)->execute(
+            Dish::first()->id,
+            new UpdateDishDTO(
+                name_ar: 'اسم جديد',
+                name_en: 'New name',
+                description_ar: null,
+                description_en: null,
+                price: null,
+                category_id: null,
+                is_featured: null,
+                is_signature: null,
+                image: null,
+                order: null,
+            ),
+        );
+
+        foreach ($cachedKeys as $key) {
+            $this->assertFalse(Cache::has($key), "stale dish cache left behind under [{$key}]");
+        }
+
+        $this->assertSame([], CacheGroup::keys('dishes'));
+    }
+
+    public function test_flushing_one_group_leaves_other_groups_intact(): void
+    {
+        app(GetDishesAction::class)->execute();
+
+        app(UpdateSettingsAction::class)->execute(
+            new UpdateSettingDTO(settings: ['site_name' => 'Abouelsid']),
+        );
+
+        $this->assertTrue(Cache::has('dishes_ar_all_all_all_default_1'));
+    }
+}
