@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Enums\QuoteRequestStatusEnum;
+use App\Http\Controllers\Controller;
+use App\Models\Branch;
+use App\Models\CateringPackage;
+use App\Models\Category;
+use App\Models\DeliveryApp;
+use App\Models\Dish;
+use App\Models\QuoteRequest;
+use App\Models\Testimonial;
+use App\Models\Timeline;
+use App\Models\User;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Support\Facades\Cache;
+
+class DashboardController extends Controller
+{
+    public function stats(): JsonResponse
+    {
+        $stats = Cache::remember('dashboard_stats', now()->addMinutes(5), function () {
+            return [
+                'dishes' => [
+                    'total' => Dish::count(),
+                    'featured' => Dish::where('is_featured', true)->count(),
+                    'signature' => Dish::where('is_signature', true)->count(),
+                ],
+                'categories' => [
+                    'total' => Category::count(),
+                ],
+                'branches' => [
+                    'total' => Branch::count(),
+                ],
+                'catering_packages' => [
+                    'total' => CateringPackage::count(),
+                ],
+                'quote_requests' => [
+                    'total' => QuoteRequest::count(),
+                    'pending' => QuoteRequest::where('status', QuoteRequestStatusEnum::Pending)->count(),
+                    'reviewed' => QuoteRequest::where('status', QuoteRequestStatusEnum::Reviewed)->count(),
+                    'contacted' => QuoteRequest::where('status', QuoteRequestStatusEnum::Contacted)->count(),
+                    'closed' => QuoteRequest::where('status', QuoteRequestStatusEnum::Closed)->count(),
+                ],
+                'testimonials' => [
+                    'total' => Testimonial::count(),
+                    'active' => Testimonial::where('is_active', true)->count(),
+                ],
+                'timeline' => [
+                    'total' => Timeline::count(),
+                ],
+                'delivery_apps' => [
+                    'total' => DeliveryApp::count(),
+                    'active' => DeliveryApp::where('is_active', true)->count(),
+                ],
+                'users' => [
+                    'total' => User::count(),
+                ],
+            ];
+        });
+
+        return $this->success($stats, __('messages.fetched'));
+    }
+}
