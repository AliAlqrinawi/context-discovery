+<?php
+
+namespace App\Repositories;
+
+use App\Models\Dish;
+use Illuminate\Pagination\LengthAwarePaginator;
+
+class DishRepository
+{
+    public function getAll(array $filters = []): LengthAwarePaginator
+    {
+        $query = Dish::with('category')->orderBy('order');
+
+        if (! empty($filters['category_id'])) {
+            $query->where('category_id', $filters['category_id']);
+        }
+
+        if (array_key_exists('featured', $filters) && $filters['featured'] !== null) {
+            $query->where('is_featured', $filters['featured']);
+        }
+
+        if (array_key_exists('signature', $filters) && $filters['signature'] !== null) {
+            $query->where('is_signature', $filters['signature']);
+        }
+
+        return $query->paginate($filters['per_page'] ?? 12);
+    }
+
+    public function getById(int $id): Dish
+    {
+        return Dish::with('category')->findOrFail($id);
+    }
+
+    public function create(array $data): Dish
+    {
+        return Dish::create($data);
+    }
+
+    public function update(int $id, array $data): Dish
+    {
+        $dish = Dish::findOrFail($id);
+        $dish->update($data);
+
+        return $dish;
+    }
+
+    public function delete(int $id): void
+    {
+        Dish::findOrFail($id)->delete();
+    }
+}
