+<?php
+
+namespace App\Repositories;
+
+use App\Models\User;
+use Illuminate\Pagination\LengthAwarePaginator;
+use Illuminate\Support\Facades\DB;
+
+class UserRepository
+{
+    public function getAll(): LengthAwarePaginator
+    {
+        return User::with('roles')->paginate(15);
+    }
+
+    public function getById(int $id): User
+    {
+        return User::with('roles')->findOrFail($id);
+    }
+
+    public function create(array $data, string $role): User
+    {
+        return DB::transaction(function () use ($data, $role) {
+            $user = User::create($data);
+            $user->assignRole($role);
+
+            return $user;
+        });
+    }
+
+    public function update(int $id, array $data): User
+    {
+        $user = User::findOrFail($id);
+        $user->update($data);
+
+        return $user;
+    }
+
+    public function delete(int $id): void
+    {
+        User::findOrFail($id)->delete();
+    }
+}
diff --git a/tests/Feature/RepositoriesTest.php b/tests/Feature/RepositoriesTest.php
new file mode 100644
index 0000000..ab0f9e2
--- /dev/null
+++ b/tests/Feature/RepositoriesTest.php
@@ -0,0 +1,387 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Repositories\BranchRepository;
+use App\Repositories\CategoryRepository;
+use App\Repositories\CateringPackageRepository;
+use App\Repositories\DeliveryAppRepository;
+use App\Repositories\DishRepository;
+use App\Repositories\MediaItemRepository;
+use App\Repositories\PageContentRepository;
+use App\Repositories\QuoteRequestRepository;
+use App\Repositories\SampleMenuRepository;
+use App\Repositories\SettingRepository;
+use App\Repositories\TestimonialRepository;
+use App\Repositories\TimelineRepository;
+use App\Repositories\UserRepository;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class RepositoriesTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->seed();
+    }
+
+    // ── PageContentRepository ──────────────────────────────────
+
+    public function test_page_content_repository_get_by_page_groups_by_section_and_key(): void
+    {
+        $repo = new PageContentRepository;
+
+        $result = $repo->getByPage('home');
+
+        $this->assertTrue($result->has('hero'));
+        $this->assertTrue($result->get('hero')->has('title'));
+        $this->assertSame('أبو السيد', $result->get('hero')->get('title')->value_ar);
+    }
+
+    public function test_page_content_repository_get_by_page_filters_by_section(): void
+    {
+        $repo = new PageContentRepository;
+
+        $result = $repo->getByPage('home', 'hero');
+
+        $this->assertCount(1, $result);
+        $this->assertTrue($result->has('hero'));
+    }
+
+    public function test_page_content_repository_update_only_touches_value_fields(): void
+    {
+        $repo = new PageContentRepository;
+        $id = \App\Models\PageContent::where('page', 'home')->where('section', 'hero')->where('key', 'title')->first()->id;
+
+        $updated = $repo->update($id, ['value_ar' => 'اسم جديد', 'value_en' => 'New Name', 'page' => 'hacked']);
+
+        $this->assertSame('اسم جديد', $updated->value_ar);
+        $this->assertSame('New Name', $updated->value_en);
+        $this->assertSame('home', $updated->page);
+    }
+
+    public function test_page_content_repository_bulk_update_runs_in_transaction(): void
+    {
+        $repo = new PageContentRepository;
+        $ids = \App\Models\PageContent::limit(2)->pluck('id');
+
+        $repo->bulkUpdate([
+            ['id' => $ids[0], 'value_ar' => 'قيمة 1', 'value_en' => 'Value 1'],
+            ['id' => $ids[1], 'value_ar' => 'قيمة 2', 'value_en' => 'Value 2'],
+        ]);
+
+        $this->assertSame('قيمة 1', \App\Models\PageContent::find($ids[0])->value_ar);
+        $this->assertSame('قيمة 2', \App\Models\PageContent::find($ids[1])->value_ar);
+    }
+
+    // ── MediaItemRepository ─────────────────────────────────────
+
+    public function test_media_item_repository_get_by_page_groups_by_section_and_key(): void
+    {
+        $repo = new MediaItemRepository;
+
+        $result = $repo->getByPage('global', 'textures');
+
+        $this->assertTrue($result->has('textures'));
+        $this->assertTrue($result->get('textures')->has('green'));
+    }
+
+    public function test_media_item_repository_crud(): void
+    {
+        $repo = new MediaItemRepository;
+
+        $created = $repo->create([
+            'page' => 'menu', 'section' => 'hero', 'key' => 'background',
+            'alt_ar' => 'خلفية', 'alt_en' => 'Background',
+        ]);
+
+        $updated = $repo->update($created->id, ['alt_en' => 'Updated Background']);
+        $this->assertSame('Updated Background', $updated->alt_en);
+
+        $repo->delete($created->id);
+        $this->assertDatabaseMissing('media_items', ['id' => $created->id]);
+    }
+
+    // ── SettingRepository ────────────────────────────────────────
+
+    public function test_setting_repository_get_all_keyed_by_key(): void
+    {
+        $repo = new SettingRepository;
+
+        $result = $repo->getAll();
+
+        $this->assertCount(17, $result);
+        $this->assertTrue($result->has('whatsapp_number'));
+    }
+
+    public function test_setting_repository_get_all_filters_by_group(): void
+    {
+        $repo = new SettingRepository;
+
+        $result = $repo->getAll('social');
+
+        $this->assertCount(5, $result);
+    }
+
+    public function test_setting_repository_bulk_update_runs_in_transaction(): void
+    {
+        $repo = new SettingRepository;
+
+        $repo->bulkUpdate(['whatsapp_number' => '+966500000000']);
+
+        $this->assertSame('+966500000000', \App\Models\Setting::where('key', 'whatsapp_number')->first()->value);
+    }
+
+    // ── CategoryRepository ───────────────────────────────────────
+
+    public function test_category_repository_get_all_returns_six_ordered(): void
+    {
+        $repo = new CategoryRepository;
+
+        $result = $repo->getAll();
+
+        $this->assertCount(6, $result);
+        $this->assertSame('starters', $result->first()->slug);
+    }
+
+    public function test_category_repository_crud(): void
+    {
+        $repo = new CategoryRepository;
+
+        $created = $repo->create(['name_ar' => 'تجربة', 'name_en' => 'Test', 'slug' => 'test-cat', 'order' => 99]);
+        $this->assertDatabaseHas('categories', ['slug' => 'test-cat']);
+
+        $updated = $repo->update($created->id, ['name_en' => 'Updated']);
+        $this->assertSame('Updated', $updated->name_en);
+
+        $repo->delete($created->id);
+        $this->assertDatabaseMissing('categories', ['id' => $created->id]);
+    }
+
+    // ── DishRepository ───────────────────────────────────────────
+
+    public function test_dish_repository_get_all_paginates_with_category_loaded(): void
+    {
+        $repo = new DishRepository;
+
+        $result = $repo->getAll();
+
+        $this->assertSame(5, $result->total());
+        $this->assertTrue($result->first()->relationLoaded('category'));
+    }
+
+    public function test_dish_repository_filters_by_featured(): void
+    {
