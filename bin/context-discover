#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * context-discover — diff in, context bundle out.
 *
 * Contract: docs/architecture/03-interfaces.md §1. The bundle goes to stdout, diagnostics to
 * stderr, and the exit code says which of the three outcomes happened. There is no --out: shell
 * redirection already covers it.
 *
 * This file does argv, stream plumbing and exit codes, and nothing else. Every decision about
 * what the tool does lives behind Cli\Wiring.
 */

use ContextDiscovery\Cli\ExitCode;
use ContextDiscovery\Cli\Options;
use ContextDiscovery\Cli\Wiring;

$autoload = __DIR__ . '/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "context-discover: dependencies are not installed. Run: composer install\n");
    exit(ExitCode::UsageError->value);
}

require $autoload;

try {
    $options = Options::fromArgv($argv);
} catch (InvalidArgumentException $error) {
    fwrite(STDERR, 'context-discover: ' . $error->getMessage() . "\n");
    exit(ExitCode::UsageError->value);
}

$diffText = $options->readsStdin()
    ? (string) stream_get_contents(STDIN)
    : (is_file($options->diffPath) && is_readable($options->diffPath)
        ? (string) file_get_contents($options->diffPath)
        : null);

if ($diffText === null) {
    fwrite(STDERR, sprintf("context-discover: cannot read the diff at %s\n", $options->diffPath));
    exit(ExitCode::UsageError->value);
}

try {
    $command = (new Wiring())->discoverCommand($options, STDOUT, STDERR);
} catch (RuntimeException $error) {
    // The repository root is the one input the tool cannot work around.
    fwrite(STDERR, 'context-discover: ' . $error->getMessage() . "\n");
    exit(ExitCode::RepositoryUnreadable->value);
}

try {
    exit($command->run($diffText, $options->budgetTokens)->value);
} catch (InvalidArgumentException $error) {
    // A diff this tool cannot read is an input error, never a half-parsed bundle.
    fwrite(STDERR, 'context-discover: ' . $error->getMessage() . "\n");
    exit(ExitCode::UsageError->value);
}
